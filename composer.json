{
  "name": "diablomedia/arcanist-extensions",
  "description": "Collection of Arcanist extensions use for linting/testing code with Arcanist and Phabricator/Phorge",
  "license": "MIT",
  "authors": [
    {
      "name": "Jay Klehr",
      "email": "jay@diablomedia.com"
    }
  ],
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "phorgeit/arcanist",
        "version": "1.0.0",
        "dist": {
          "url": "https://github.com/phorgeit/arcanist/archive/5d3f910dfa2927d740cec7c49287d6d5b0422dc4.zip",
          "type": "zip"
        },
        "source": {
          "url": "https://github.com/phorgeit/arcanist.git",
          "type": "git",
          "reference": "5d3f910dfa2927d740cec7c49287d6d5b0422dc4"
        }
      }
    }
  ],
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "ptlis/diff-parser": "^1.1.0"
  },
  "require-dev": {
    "diablomedia/php-cs-fixer-config": "^2.1.0",
    "friendsofphp/php-cs-fixer": "3.6.0",
    "phorgeit/arcanist": "1.0.0",
    "phpstan/phpstan": "2.3.1"
  },
  "autoload-dev": {
    "classmap": [
      "extensions/",
      "vendor/phorgeit/arcanist/src/"
    ]
  },
  "scripts": {
    "phpstan": "phpstan analyze -c phpstan.neon --memory-limit=768M",
    "php-cs-fixer": "php-cs-fixer fix --verbose",
    "test": "vendor/phorgeit/arcanist/bin/arc --load-phutil-library=extensions/oxfmt_linter --load-phutil-library=extensions/oxlint_linter --load-phutil-library=extensions/vitest_unit_test_engine --load-phutil-library=extensions/php_cs_fixer_linter unit --engine PhutilUnitTestEngine -- extensions/oxfmt_linter/src/OxfmtLinter.php extensions/oxlint_linter/src/OxlintLinter.php extensions/vitest_unit_test_engine/src/VitestUnitTestEngine.php extensions/php_cs_fixer_linter/src/Linter/LintMessageBuilder.php"
  }
}
